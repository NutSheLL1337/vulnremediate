## Recommended Fix

{% if vulnerability.language == 'php' %}
```php
// AVOID: Hardcoded passwords in source code
// $db_password = "MySecretPass123";  // VULNERABLE

// Use environment variables
$db_password = getenv('DB_PASSWORD');

// OR use configuration file (outside web root)
$config = parse_ini_file('/etc/myapp/config.ini');
$db_password = $config['db_password'];

// Connection example
$mysqli = new mysqli(
    getenv('DB_HOST'),
    getenv('DB_USER'),
    getenv('DB_PASSWORD'),
    getenv('DB_NAME')
);
```
{% elif vulnerability.language == 'python' %}
```python
# AVOID: Hardcoded credentials
# API_KEY = "sk-1234567890abcdef"  # VULNERABLE

# Use environment variables
import os
api_key = os.getenv('API_KEY')

# OR use python-dotenv for development
from dotenv import load_dotenv
load_dotenv()
api_key = os.getenv('API_KEY')

# For production, use secrets management
# - AWS Secrets Manager
# - HashiCorp Vault
# - Azure Key Vault
```
{% else %}
