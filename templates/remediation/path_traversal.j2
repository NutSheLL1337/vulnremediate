## Recommended Fix

{% if vulnerability.language == 'php' %}
```php
// AVOID: Direct file access with user input
// include($_GET['page']);  // VULNERABLE

// Use whitelist approach
$allowed_files = ['home.php', 'about.php', 'contact.php'];
$page = $_GET['page'] ?? 'home.php';

if (in_array($page, $allowed_files)) {
    include($page);
} else {
    // Handle error
    include('404.php');
}

// OR use basename() and realpath() validation
$base_dir = '/var/www/html/pages/';
$file = basename($_GET['page']);
$full_path = realpath($base_dir . $file);

// Ensure path is within allowed directory
if ($full_path && strpos($full_path, $base_dir) === 0) {
    include($full_path);
}
```
{% elif vulnerability.language == 'python' %}
```python
# AVOID: Direct file operations with user input
# open(user_filename, 'r')  # VULNERABLE

# Use whitelist approach
import os
from pathlib import Path

ALLOWED_DIR = Path('/var/www/files')
filename = request.args.get('file', '')

# Resolve and validate path
file_path = (ALLOWED_DIR / filename).resolve()

# Ensure path is within allowed directory
if file_path.is_relative_to(ALLOWED_DIR) and file_path.exists():
    with open(file_path, 'r') as f:
        content = f.read()
```
